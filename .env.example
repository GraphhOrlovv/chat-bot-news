# Какой ИИ-провайдер использовать: gemini | claude
AI_PROVIDER=gemini

# Google AI Studio (aistudio.google.com/apikey) — бесплатно, без карты
GEMINI_API_KEY=

# Нужен только если AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Токен бота из @BotFather
BOT_TOKEN=

# Порт core-сервера (REST API)
PORT=3000

# Твой chat_id — сюда бот будет присылать ежедневную сводку.
# Узнать свой chat_id можно, написав боту @userinfobot
MY_CHAT_ID=

# Когда слать ежедневную сводку (cron-выражение) и в каком часовом поясе
DIGEST_CRON=0 9 * * *
DIGEST_TIMEZONE=Europe/Moscow
